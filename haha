-- Hàm tự động chuyển đổi ID Decal/Image thành rbxthumb để chắc chắn hiển thị 100%
local function FixRobloxImageId(id)
    local numId = tostring(id):match("%d+")
    if numId then
        return "rbxthumb://type=Asset&id=" .. numId .. "&w=420&h=420"
    end
    return id
end

