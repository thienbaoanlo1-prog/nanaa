local function execute(code, button)
    SylPhinPlayExecute()
    local oldText = button.Text
    button.Text = "LOADING..."
    task.spawn(function()
        local ok, fnOrErr = pcall(loadstring, code)
        if ok and type(fnOrErr) == "function" then
            task.spawn(function()
                local ran, err = pcall(fnOrErr)
                if not ran then warn("[SylPhin] Script error:", err) end
            end)
            button.Text = "EXECUTED ✓"
        else
            warn("[SylPhin] Load error:", fnOrErr)
            button.Text = "ERROR"
        end
        task.wait(0.8)
        if button and button.Parent then
            button.Text = oldText
        end
    end)
end

